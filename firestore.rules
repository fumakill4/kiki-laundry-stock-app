rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.get('jclAdmin', false) == true; }
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role'])
        && request.resource.data.role == 'Pending';
      allow update, delete: if isAdmin();
    }
    match /items/{id} { allow read, write: if isAdmin(); }
    match /outlets/{id} {
      allow read, write: if isAdmin();
      match /{document=**} { allow read, write: if isAdmin(); }
    }
    match /transactions/{id} { allow read, write: if isAdmin(); }
    match /backups/{id} { allow read, write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
